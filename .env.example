# PostgreSQL Database Connection String
DATABASE_URL="postgresql://user:password@localhost:5432/university_merit_db"

# Google Gemini API Key (Required for AI Advisor responses)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Gemini Model Selection (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Secret required to trigger /api/seed in production (Optional in dev)
SEED_SECRET="your_custom_seed_secret_here"
